  "findings": [
    {
      "id": "B01-F1",
      "severity": "P1",
      "title": "consult parses, on every edit, the part of the link state it never reads",
      "evidence": {
        "symbol_locations_bytes": 1417793,
        "notes_bytes": 51133,
        "state_bytes": 1510604,
        "share_of_state": 0.939,
        "json_parse_ms": 9.78,
        "consult_p50_ms": 9.91
      },
      "consequence": "per-edit cost scales with the size of the INDEX, not the size of the vault"
    },
    {
      "id": "B01-F2",
      "severity": "P1",
      "title": "incremental linking saves about a quarter, not 4-5x, on a large repository",
      "evidence": {
        "link_empty_vault_s": 0.638,
        "link_full_s": 0.843,
        "link_incremental_s": 0.931,
        "fixed_cost_share": 0.76
      },
      "consequence": "the fixed cost is the tree walk; the skip can only save what is left"
    },
    {
      "id": "B01-F3",
      "severity": "P0",
      "title": "staleness of a backend's INPUT is invisible",
      "evidence": {
        "graph_age_days": 36,
        "index_freshness_reported": "fresh",
        "freshness_reason": "fingerprint-match",
        "line_probe_sample": 300,
        "lines_still_correct": 175,
        "lines_wrong": 125,
        "wrong_share": 0.417,
        "control_scan_backend": {
          "sample": 300,
          "correct": 300,
          "wrong": 0
        }
      },
      "consequence": "freshness is transitive and the chain is not checked: 'the derived index is unchanged' was reported where 'the evidence it was built from is current' was meant"
    },
    {
      "id": "B01-F4",
      "severity": "P0",
      "title": "a mismatch between the path base a backend records and the --repo given passes silently",
      "evidence": {
        "links_emitted": 104,
        "paths_that_resolve": 0,
        "only_signal": "index_completeness: partial"
      },
      "consequence": "anchors that point at no code, with no fail-closed"
    },
    {
      "id": "B01-O1",
      "severity": "P2",
      "title": "one backend emits module docstrings as symbol names",
      "consequence": "index noise ingested without a filter"
    }
  ],
  "discipline": "None of these was fixed while the benchmark that found them was running. Widening a heuristic to turn a benchmark green is how a tool ends up overfitted to the one repository it was tested on."
